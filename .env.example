# Required for the chatbot (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model
ANTHROPIC_MODEL=claude-haiku-5-5

# Required for /admin
ADMIN_PASSWORD=change-me

# GA4 measurement ID (public by design)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Set to "true" to see events in GA4 DebugView while testing
NEXT_PUBLIC_GA_DEBUG=true

# Optional: persistent storage on Vercel (Upstash Redis from the Vercel Marketplace).
# Either naming scheme works. Without these, edits persist locally but NOT on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
